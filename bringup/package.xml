<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_wall_bringup</name>
  <version>1.0.0</version>
  <description>Bringup package for the SLLIDAR and wall detection stack</description>
  <maintainer email="ros@slamtec.com">Slamtec ROS Maintainer</maintainer>
  <license>BSD</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sllidar_wall</exec_depend>
  <exec_depend>wall_detection</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
